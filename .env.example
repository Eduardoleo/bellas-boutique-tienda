PORT=3001
JWT_SECRET=[COMPLETAR]
DEMO_ADMIN_PASSWORD=[COMPLETAR]
EMAIL_USER=[COMPLETAR]
EMAIL_PASS=[COMPLETAR]
EMAIL_FROM_ADDRESS=[COMPLETAR]
EMAIL_FROM_NAME=[COMPLETAR]
# Orígenes permitidos por CORS (separados por comas, sin barra final).
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
CONTACT_PHONE=[COMPLETAR]
COMPANY_ADDRESS=[COMPLETAR]

# SQLite: rutas relativas resueltas desde server/, no desde el directorio actual.
# El directorio padre debe existir. No utilice una base real para demos o pruebas.
BB_SQLITE_PATH=database.sqlite
# seed-demo exige 1 y una ruta BB_SQLITE_PATH explícita a una base demo vacía.
BB_DEMO_DATABASE=0

# Obligatorio para checkout; secreto exclusivo aleatorio de al menos 32 bytes.
# Mantener estable y respaldar fuera de Git. Nunca usar un valor de ejemplo.
BB_CHECKOUT_HASH_SECRET=
