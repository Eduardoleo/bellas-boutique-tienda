# Public backend origin/prefix, WITHOUT trailing /api. Restart Vite/rebuild after changing.
VITE_API_URL=http://localhost:4000
# Never put JWT/HMAC/email passwords here: VITE_* is public.

# Configuración de aplicación conservada
VITE_APP_NAME=Bellas Boutique
VITE_APP_VERSION=1.0.0

# Feature flags conservados
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_CHATBOT=true
