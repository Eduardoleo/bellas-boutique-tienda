{
  "name": "bellas-boutique-backend",
  "version": "1.0.0",
  "description": "Backend API para Bellas Boutique - Node.js + Express + SQLite",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "demo:prepare": "node scripts/prepareDemo.js",
    "demo:server": "node scripts/runDemoBackend.js",
    "demo:client": "node scripts/runDemoClient.js",
    "dev": "nodemon server.js",
    "init-db": "node scripts/initDatabase.js",
    "recreate-db": "node scripts/recreateDatabase.js",
    "migrate": "node scripts/addShippingColumns.js",
    "create-admin": "node scripts/createAdmin.js",
    "unlock-admin": "node scripts/unlockAdmin.js",
    "seed-faqs": "node scripts/seedFAQs.js",
    "seed-demo": "node scripts/seedDemo.js",
    "test": "node --test tests/*.test.cjs",
    "check-db": "node scripts/checkDatabase.js",
    "migrate-checkout": "node scripts/migrateCheckout.js"
